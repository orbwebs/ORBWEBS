service-account*.json
kubeconfig
.kube/

# Terraform state isolation (explicitly preserve lockfile for reproducibility)
*.tfstate
*.tfstate.*
.terraform/
!.terraform.lock.hcl

# Helm isolation (explicitly preserve lockfile)
charts/*.tgz
!Chart.lock

